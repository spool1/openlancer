  "// sceneTemplates": "The templates of Create in the Scene (milestone M3, decisions D233 and D253). Each template lists the [Solar] types of its archetypes. A connection type (a jump gate, a jump hole, an airlock gate or a trade lane ring) is in no template, because the editor adds connections in milestone M27.",
  "connectionTypes": ["jump_gate", "jump_hole", "jumphole", "airlock_gate", "tradelane_ring"],
  "sceneTemplates": [
    { "id": "station", "label": "Station", "types": ["station", "docking_ring"], "needs": "docking_sphere", "then": "base" },
    { "id": "planet", "label": "Planet", "types": ["planet"] },
    { "id": "sun", "label": "Sun", "types": ["sun"] },
    { "id": "satellite", "label": "Satellite or buoy", "types": ["satellite", "waypoint"] },
    { "id": "solar", "label": "Other solar",
      "types": ["mission_satellite", "non_targetable", "weapons_platform", "destroyable_depot"] }
  ],
  "// assetCategories": "The top categories of the Assets panel (milestone M23, decision D267), in the order of the category tree. A category takes its rows from a list or from a kind: 'propGroups' for the prop groups and 'missionPrefabs' for the mission prefab assets of the mods (section 8.3 of the M6b design). The split 'sceneTemplates' makes one child for each template of sceneTemplates and one for connectionTypes, so the types of a category and of its Create template cannot differ. The split 'section' makes one child for each section type, and 'folder' one for each top folder below the data folder.",
  "assetCategories": [
    { "id": "groups", "label": "Prop groups", "kind": "propGroups" },
    { "id": "solars", "label": "Solars", "list": "solar_archetype", "split": "sceneTemplates" },
    { "id": "ships", "label": "Ships", "list": "ship" },
    { "id": "asteroids", "label": "Asteroids", "list": "asteroid" },
    { "id": "equipment", "label": "Equipment", "list": "equipment", "split": "section" },
    { "id": "effects", "label": "Effects", "list": "effect" },
    { "id": "loadouts", "label": "Loadouts", "list": "loadout" },
    { "id": "factions", "label": "Factions", "list": "faction" },
    { "id": "models", "label": "Models", "list": "model", "split": "folder" },
    { "id": "prefabs", "label": "Mission prefabs", "kind": "missionPrefabs" }
  ],
  "// sceneBuilders": "The builders of the agent tools (milestone MCP1-2, decisions D730 and D731). 'wreck' gives a new wreck: the [Solar] types of its archetype, its lines, and its name and info texts. 'routes' gives the zones of a route for each usage, with the default radius and the lines of each zone in their order. A line without a value is a line that the builder fills: path_label and usage. The values follow counts over the retail system files. 146 of the 160 retail wreck objects have visit = 16. 3036 of the 3038 retail route zones have a radius of 750, and the other values are the most frequent values of each usage.",
  "sceneBuilders": {
    "wreck": {
      "help": "A wreck is a solar of the type mission_satellite with a loadout of a ship. The player shoots it to free its cargo.",
      "types": ["mission_satellite"],
      "lines": [ { "key": "visit", "value": "16" } ],
      "name": "Wreck",
      "info": "The remains of a ship. Shoot the wreck to free its cargo."
    },
    "routes": [
      { "usage": "patrol", "radius": 750,
        "help": "A patrol route. The encounters of its zones send ships along the legs of the route.",
        "lines": [
          { "key": "sort", "value": "99" }, { "key": "toughness", "value": "7" }, { "key": "density", "value": "3" },
          { "key": "repop_time", "value": "90" }, { "key": "max_battle_size", "value": "4" },
          { "key": "pop_type", "value": "attack_patrol" }, { "key": "relief_time", "value": "30" },
          { "key": "path_label" }, { "key": "usage" }, { "key": "mission_eligible", "value": "true" }
        ] },
      { "usage": "trade", "radius": 750,
        "help": "A trade route. The encounters of its zones send traders along the legs of the route.",
        "lines": [
          { "key": "sort", "value": "96" }, { "key": "toughness", "value": "12" }, { "key": "density", "value": "5" },
          { "key": "repop_time", "value": "30" }, { "key": "max_battle_size", "value": "4" },
          { "key": "pop_type", "value": "trade_path" }, { "key": "relief_time", "value": "20" },
          { "key": "path_label" }, { "key": "usage" }, { "key": "mission_eligible", "value": "true" }
        ] }
    ]
  }
