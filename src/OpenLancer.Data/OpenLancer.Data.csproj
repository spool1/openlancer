<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- AtomicFile.MoveOver calls the Windows rename through LibraryImport, which generates unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\Librelancer\src\LibreLancer.Data\LibreLancer.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rule data of the data lists (milestone M21, decision D112). -->
    <EmbeddedResource Include="Editing\Lists\list-rules.json" LogicalName="OpenLancer.Data.Editing.Lists.list-rules.json" />
    <!-- The argument schema and the behavior prefabs of mission scripts (milestone M6a, decisions D524 and D525). -->
    <EmbeddedResource Include="Missions\mission-schema.json" LogicalName="OpenLancer.Data.Missions.mission-schema.json" />
    <EmbeddedResource Include="Missions\mission-prefabs.json" LogicalName="OpenLancer.Data.Missions.mission-prefabs.json" />
    <!-- The templates of the built-in behavior prefabs (milestone M6b-3, decision D672). The file name is the prefab
         id. -->
    <EmbeddedResource Include="Missions\Prefabs\*.ini" LogicalName="OpenLancer.Data.Missions.Prefabs.%(Filename).ini" />
    <!-- The file lists of the known game builds (milestone M11a). The file name is the build id. They hold paths, sizes
         and hashes only. -->
    <EmbeddedResource Include="..\..\data-manifest\*.tsv" LogicalName="OpenLancer.Data.Games.%(Filename).tsv" />
  </ItemGroup>

  <!-- The engine commit of the build, as the assembly metadata "EngineCommit" (BuildInfo.EngineCommit). tools/release.ps1
       gives it in the property OpenLancerEngineCommit. Else the build reads the HEAD of the engine checkout with git.
       Only a checkout of its own has a .git entry. Without it, git would give the commit of the folder above. The
       command drops the error output, and the build keeps the output only when it is 40 hex characters. So without git
       or without the checkout, the build writes no metadata and gives no warning. -->
  <Target Name="AddEngineCommit" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <_EngineFolder>$(MSBuildThisFileDirectory)../../external/Librelancer</_EngineFolder>
      <_NullDevice Condition="$([MSBuild]::IsOSPlatform('Windows'))">nul</_NullDevice>
      <_NullDevice Condition="'$(_NullDevice)' == ''">/dev/null</_NullDevice>
    </PropertyGroup>
    <Exec Condition="'$(OpenLancerEngineCommit)' == '' and Exists('$(_EngineFolder)/.git')"
          Command="git -C &quot;$(_EngineFolder)&quot; rev-parse HEAD 2&gt;$(_NullDevice)"
          EchoOff="true" ConsoleToMSBuild="true" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_EngineHead" />
    </Exec>
    <PropertyGroup Condition="'$(OpenLancerEngineCommit)' == '' and
                              $([System.Text.RegularExpressions.Regex]::IsMatch('$(_EngineHead)', '^[0-9a-f]{40}$'))">
      <OpenLancerEngineCommit>$(_EngineHead)</OpenLancerEngineCommit>
    </PropertyGroup>
    <ItemGroup Condition="'$(OpenLancerEngineCommit)' != ''">
      <AssemblyMetadata Include="EngineCommit" Value="$(OpenLancerEngineCommit)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The shared command layer and the agent tools read the edit session as the commands of DA do: the system files,
         the nicknames, the data lists and the documents (section 4.0.2 of the M6b design). -->
    <InternalsVisibleTo Include="OpenLancer.Studio" />
    <InternalsVisibleTo Include="OpenLancer.Tests" />
    <!-- The retail proofs test the internal patch writer directly. -->
    <InternalsVisibleTo Include="OpenLancer.DataTests" />
  </ItemGroup>

</Project>
