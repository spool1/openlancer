<Project Sdk="Microsoft.NET.Sdk">

  <!-- Copies the Librelancer natives and dll.config files next to the test assembly. -->
  <Import Project="..\..\external\Librelancer\src\PublishAssets\PublishAssets.projitems" Label="Shared" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\Librelancer\src\LibreLancer\LibreLancer.csproj" />
    <ProjectReference Include="..\..\src\OpenLancer.Runtime\OpenLancer.Runtime.csproj" />
    <!-- The oltool tests run oltool from the test folder. -->
    <ProjectReference Include="..\..\src\OpenLancer.Tools\OpenLancer.Tools.csproj" />
    <!-- The retail proofs of the cutscene editor send each kind of edit of the editor through its command path. -->
    <ProjectReference Include="..\..\src\OpenLancer.Editor\OpenLancer.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The retail move proofs script ImGuizmo with the formulas of the unit tests. -->
    <Compile Include="..\OpenLancer.Tests\ImGuizmoResults.cs" Link="ImGuizmoResults.cs" />
    <!-- The retail move proofs open each drag of the gizmo in its gesture, as the editor does. -->
    <Compile Include="..\OpenLancer.Tests\TestGestures.cs" Link="TestGestures.cs" />
    <!-- The retail tests of the agent tools check each result with the schema check of the unit tests. -->
    <Compile Include="..\OpenLancer.Tests\SchemaCheck.cs" Link="SchemaCheck.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
